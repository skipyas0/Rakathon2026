# Copy to .env (git-ignored). Never commit real keys or real patient data.
FHIR_BASE_URL=http://localhost:8080/fhir
# InterSystems IRIS for Health instead of HAPI:
# FHIR_BASE_URL=http://localhost:52773/fhir/r4
# FHIR_USER=SuperUser
# FHIR_PASSWORD=SYS
# LLM (docs/decisions.md #13): Azure APIM, OpenAI-compatible
# AZURE_API_KEY=...
# LLM_BASE_URL=https://apim-rakathon-q7146n.azure-api.net/openai/v1
# LLM_MODEL=gpt-6-luna-dz-eu
# PDF fonts with Czech glyphs (default: Arial on macOS, DejaVu on Linux)
# PDF_FONT=/path/Regular.ttf
# PDF_FONT_BOLD=/path/Bold.ttf
# Organisers' dataset (default: Dataset/ at the repo root)
# DATASET_DIR=/path/to/Dataset_MDT_Copilot_v1.1
# Shared password for the deployed app (HTTP basic auth, any username); unset = no login
# APP_PASSWORD=
